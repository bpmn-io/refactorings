{
  "name": "@bpmn-io/refactorings",
  "version": "1.0.0",
  "description": "Refactorings feature for bpmn-js",
  "author": {
    "name": "Philipp Fromme",
    "url": "https://github.com/philippfromme"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "bugs": {
    "url": "https://github.com/bpmn-io/refactorings/issues"
  },
  "homepage": "https://github.com/bpmn-io/refactorings#readme",
  "license": "MIT",
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "all": "run-s lint test build",
    "test": "karma start karma.config.js",
    "test:openai": "cross-env TEST_OPENAI=true karma start karma.config.js",
    "lint": "eslint .",
    "dev": "npm test -- --auto-watch --no-single-run",
    "dev:openai": "cross-env TEST_OPENAI=true npm test -- --auto-watch --no-single-run",
    "start": "cross-env SINGLE_START=true npm run dev",
    "build": "rollup -c --bundleConfigAsCjs",
    "build:watch": "rollup -cw --bundleConfigAsCjs",
    "fetch-element-templates": "node ./scripts/fetch-element-templates.js",
    "prepare": "run-s build"
  },
  "dependencies": {
    "@carbon/styles": "^1.53.1",
    "min-dash": "^5.0.0",
    "min-dom": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@bpmn-io/element-template-chooser": "^2.1.0",
    "@bpmn-io/element-template-icon-renderer": "^1.0.0",
    "@bpmn-io/properties-panel": "^3.39.0",
    "@camunda/improved-canvas": "^1.7.7",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/preact": "^3.2.4",
    "babel-loader": "^10.0.0",
    "bpmn-js": "^18.12.0",
    "bpmn-js-create-append-anything": "^1.2.0",
    "bpmn-js-element-templates": "^2.20.0",
    "bpmn-js-properties-panel": "^5.50.1",
    "camunda-bpmn-js-behaviors": "^1.14.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.3",
    "diagram-js": "^15.9.1",
    "dotenv": "^17.2.4",
    "dotenv-webpack": "^8.1.1",
    "downloadjs": "^1.4.7",
    "eslint": "^8.40.0",
    "eslint-plugin-bpmn-io": "^1.0.0",
    "eslint-plugin-import": "^2.27.5",
    "file-drops": "^0.7.0",
    "git": "^0.1.5",
    "html-webpack-plugin": "^5.6.6",
    "karma": "^6.4.4",
    "karma-chrome-launcher-2": "^3.3.0",
    "karma-coverage": "^2.2.1",
    "karma-debug-launcher": "^0.0.5",
    "karma-env-preprocessor": "^0.1.1",
    "karma-mocha": "^2.0.1",
    "karma-sinon-chai": "^2.0.2",
    "karma-webpack": "^5.0.0",
    "mocha": "^10.2.0",
    "mocha-test-container-support": "^0.2.0",
    "node-sass": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "openai": "^4.17.0",
    "postcss": "^8.4.37",
    "puppeteer": "^24.37.2",
    "raw-loader": "^4.0.2",
    "rollup": "^4.57.1",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "sinon": "^16.1.0",
    "sinon-chai": "^3.7.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.105.1",
    "zeebe-bpmn-moddle": "^1.12.0"
  },
  "peerDependencies": {
    "bpmn-js": "*",
    "bpmn-js-element-templates": "*",
    "diagram-js": "*"
  }
}
